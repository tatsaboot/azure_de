{
	"name": "PL_SEND_MAIL",
	"properties": {
		"activities": [
			{
				"name": "Read all tables status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT  * \nFROM [ctrl].[audit_log]\nwhere adf_run_id = '@{pipeline().parameters.adf_run_id}'\norder by table_id",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Prepare Email Body Header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_header",
					"value": "Ingeastion and Transform process for azure data pipeline process"
				}
			},
			{
				"name": "Prepare Email Body Footer",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_footer",
					"value": "For any support, Please reach out to support@gmail.com"
				}
			},
			{
				"name": "Prepare Email Subject",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Checked overall failed count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "@{pipeline().globalParameters.env} | @{if(greater(activity('Checked overall failed count').output.firstRow.count,0),'FAILED','SUCCESS')} | AZURE PIPELINE MASTER RUN",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Checked overall failed count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT  COUNT(*) as Count\nFROM [ctrl].[audit_log]\nwhere adf_run_id = '@{pipeline().parameters.adf_run_id}'\nAND status != 'SUCCESS'\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Prepare Logic apps body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Prepare Email Subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare Email Body Footer",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare Email Body Header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Read all tables status",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\n        \"subject\": \"@{variables('email_subject')}\",\n        \"email_receipients\":\"@{pipeline().globalParameters.email_receipt}\",\n        \"body_header\": \"@{variables('body_header')}\",\n        \"body_footer\": \"@{variables('body_footer')}\",\n        \"status_table\":@{activity('Read all tables status').output.value}\n}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string",
				"defaultValue": "4546bf3f-c7ec-489d-980b-2ce29ceb947f"
			}
		},
		"variables": {
			"body_header": {
				"type": "String"
			},
			"body_footer": {
				"type": "String"
			},
			"body_subject": {
				"type": "String"
			},
			"logic_apps_body": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			}
		},
		"annotations": []
	}
}